# Postgres. On an Oracle Always Free ARM box this is usually a local install:
#   postgresql://networker:PASSWORD@127.0.0.1:5432/networker
# Set PGSSL=disable for a local socket; leave it unset for managed Postgres.
DATABASE_URL=
PGSSL=disable

# Bearer token for the admin review routes. Generate one and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The service refuses to start without it rather than exposing the review queue.
ADMIN_TOKEN=

# Where the frontend is served from. Comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5195,http://localhost:5196

PORT=6040
HOST=127.0.0.1
