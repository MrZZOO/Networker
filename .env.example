# Point the form at a backend. Set ONE of the two blocks below; the form is
# disabled with a visible reason until one is present.

# (a) Our own Express service — server/ in this repo. Wins if both are set.
VITE_API_URL=

# (b) Supabase, if you have a project with headroom.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
